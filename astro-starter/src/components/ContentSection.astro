---
interface Props {
	title?: string;
	id?: string;
	class?: string;
	layout?: 'stack' | 'grid';
	columns?: 2 | 3 | 4;
	[key: string]: unknown;
}

const {
	title,
	id,
	class: className = '',
	layout = 'stack',
	columns = 2,
	...attributes
} = Astro.props;

const titleId = title && id ? `${id}-title` : undefined;
const contentLayout = layout === 'grid' ? `content-section__content--grid-${columns}` : '';
---

<section
	{...attributes}
	id={id}
	class:list={['content-section', className]}
	aria-labelledby={titleId}
>
	<div class="content-section__inner">
		{title && <h2 id={titleId}>{title}</h2>}
		<div class:list={['content-section__content', contentLayout]}>
			<slot />
		</div>
	</div>
</section>
