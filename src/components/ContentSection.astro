---
import { marked } from "marked";

interface Props {
  content: string;
}

const { content } = Astro.props;
---

<section class="content-section">
  <div class="content-section__content" set:html={marked.parse(content)} />
</section>

<style>
  .content-section {
    width: 100%;
    margin: 0;
    margin-bottom: 24px;
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1.125rem, 3vw, 2.5rem);
    color: var(--color-white);
    background: rgb(61 5 151 / 50%);
    border: 3px solid var(--edge-contrast);
    border-radius: 2rem;
    box-shadow: 0 18px 50px var(--color-navy-shadow);
  }

  @media (max-width: 640px) {
    .content-section {
      padding: 1rem;
      border-radius: 1rem;
    }
  }
</style>
