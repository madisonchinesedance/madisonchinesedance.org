---
import BlockRenderer from "./BlockRenderer.astro";

interface BlockData {
  text?: string;
  button?: {
    label: string;
    href: string;
    variant?: "primary" | "secondary" | "text";
    external?: boolean;
  };
  blocks?: BlockData[];
  layout?: "1-column" | "2-columns" | "3-columns" | "4-columns";
  variant?: "none" | "card";
}

interface Props {
  blocks: BlockData[];
  layout?: "1-column" | "2-columns" | "3-columns" | "4-columns";
  variant?: "none" | "card";
}

const {
  blocks,
  layout = "1-column",
  variant = "none",
} = Astro.props;
---

<section
  class:list={[
    "content-section",
    `layout-${layout}`,
    `variant-${variant}`,
  ]}
>
  {blocks.map((block) => <BlockRenderer block={block} />)}
</section>

<style>
  .content-section {
    /* Provides layout spacing without adding a visual treatment. */
    width: 100%;
    display: grid;
    gap: 1.5rem;
    }

  @media (max-width: 640px) {
    .content-section {
      padding-inline: 1rem;
    }

    .content-section:first-child {
      padding-top: 1rem;
    }

    .content-section:last-of-type {
      padding-bottom: 1rem;
    }

  }
</style>
