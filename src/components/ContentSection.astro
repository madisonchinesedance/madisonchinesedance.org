---
import ContentBlock from "./ContentBlock.astro";

interface BlockData {
  text?: string;
  image?: {
    src: string;
    alt: string;
    size?: "small" | "medium" | "large" | "full";
    crop?: "landscape" | "square" | "portrait" | "natural";
  };
  gallery?: {
    images: { src: string; alt: string }[];
    controls?: boolean;
    autoscroll?: boolean;
    interval?: number;
    navigation?: "thumbnails" | "dots" | "none";
    size?: "small" | "medium" | "large" | "full";
    crop?: "landscape" | "square" | "portrait" | "natural";
  };
  button?: {
    label: string;
    href: string;
    variant?: "primary" | "secondary" | "tertiary" | "text";
    external?: boolean;
  };
  blocks?: BlockData[];
  layout?: "1-column" | "2-columns" | "3-columns" | "4-columns";
  variant?: "none" | "card";
}

interface Props {
  blocks: BlockData[];
  layout?: "1-column" | "2-columns" | "3-columns" | "4-columns";
  variant?: "none" | "card";
}

const {
  blocks,
  layout = "1-column",
  variant = "none",
} = Astro.props;
---

<section
  class:list={[
    "content-section",
    `layout-${layout}`,
    `variant-${variant}`,
  ]}
>
  {blocks.map((block) => <ContentBlock block={block} />)}
</section>

<style>
  .content-section {
    /* Provides layout spacing without adding a visual treatment. */
    width: 100%;
    display: grid;
    gap: 1.5rem;
    }

  @media (max-width: 640px) {
    .content-section {
      padding-inline: 1rem;
    }

    .content-section:first-child {
      padding-top: 1rem;
    }

    .content-section:last-of-type {
      padding-bottom: 1rem;
    }

  }
</style>
