---
import ButtonBlock from "./ButtonBlock.astro";
import ContentBlock from "./ContentBlock.astro";
import TextBlock from "./TextBlock.astro";

interface BlockData {
  text?: string;
  button?: {
    label: string;
    href: string;
    variant?: "primary" | "secondary" | "text";
    external?: boolean;
  };
  blocks?: BlockData[];
  layout?: "1-column" | "2-columns" | "3-columns" | "4-columns";
  variant?: "none" | "card";
}

interface Props {
  block: BlockData;
}

const { block } = Astro.props;
---

{
  block.blocks ? (
    <ContentBlock
      variant={block.variant ?? "none"}
      layout={block.layout ?? "1-column"}
    >
      {block.blocks.map((child) => <Astro.self block={child} />)}
    </ContentBlock>
  ) : block.text !== undefined ? (
    <TextBlock content={block.text} />
  ) : block.button ? (
    <ButtonBlock
      href={block.button.href}
      variant={block.button.variant}
      external={block.button.external}
    >
      {block.button.label}
    </ButtonBlock>
  ) : null
}
