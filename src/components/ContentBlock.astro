---
interface Props {
  variant?: "none" | "card";
  layout?: "1-column" | "2-columns" | "3-columns" | "4-columns";
}

const {
  variant = "none",
  layout = "1-column",
} = Astro.props;
---

<section
  class:list={[
    "block",
    `variant-${variant}`,
    `layout-${layout}`,
  ]}
>
  <slot />
</section>

<style>
  .block {
    /* Intentionally no default spacing, background, border, or shadow. */
    width: 100%;
  }
</style>
