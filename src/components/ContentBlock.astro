---
import ButtonBlock from "./ButtonBlock.astro";
import GalleryBlock from "./GalleryBlock.astro";
import ImageBlock from "./ImageBlock.astro";
import TextBlock from "./TextBlock.astro";

interface Props {
  block: BlockData;
}

interface BlockData {
  text?: string;
  image?: {
    src: string;
    alt: string;
    size?: "small" | "medium" | "large" | "full";
    crop?: "landscape" | "square" | "portrait" | "natural";
  };
  gallery?: {
    images: { src: string; alt: string }[];
    controls?: boolean;
    autoscroll?: boolean;
    interval?: number;
    navigation?: "thumbnails" | "dots" | "none";
    size?: "small" | "medium" | "large" | "full";
    crop?: "landscape" | "square" | "portrait" | "natural";
  };
  button?: {
    label: string;
    href: string;
    variant?: "primary" | "secondary" | "text";
    external?: boolean;
  };
  blocks?: BlockData[];
  layout?: "1-column" | "2-columns" | "3-columns" | "4-columns";
  variant?: "none" | "card";
}

const { block } = Astro.props;
---

{
  block.blocks ? (
    <section
      class:list={[
        "block",
        `variant-${block.variant ?? "none"}`,
        `layout-${block.layout ?? "1-column"}`,
      ]}
    >
      {block.blocks.map((child) => <Astro.self block={child} />)}
    </section>
  ) : block.image ? (
    <ImageBlock
      src={block.image.src}
      alt={block.image.alt}
      size={block.image.size}
      crop={block.image.crop}
    />
  ) : block.gallery ? (
    <GalleryBlock
      images={block.gallery.images}
      controls={block.gallery.controls}
      autoscroll={block.gallery.autoscroll}
      interval={block.gallery.interval}
      navigation={block.gallery.navigation}
      size={block.gallery.size}
      crop={block.gallery.crop}
    />
  ) : block.text !== undefined ? (
    <TextBlock content={block.text} />
  ) : block.button ? (
    <ButtonBlock
      href={block.button.href}
      variant={block.button.variant}
      external={block.button.external}
    >
      {block.button.label}
    </ButtonBlock>
  ) : null
}

<style>
  .block {
    /* Intentionally no default spacing, background, border, or shadow. */
    width: 100%;
  }
</style>
