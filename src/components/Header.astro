---
const navigation = [
  { label: "Home", href: "/" },
  { label: "Gallery", href: "/gallery/" },
  { label: "Programs", href: "/programs/" },
  {
    label: "Classes",
    items: [
      { label: "Beginner Dancers", href: "/classes/beginner-dancers/" },
      { label: "Intermediate Dancers", href: "/classes/intermediate-dancers/" },
      { label: "Advanced Dancers", href: "/classes/advanced-dancers/" },
    ],
  },
  {
    label: "Events",
    items: [
      { label: "Events", href: "/events/" },
      { label: "Services", href: "/services/" },
    ],
  },
  {
    label: "Get Involved",
    items: [
      { label: "Dance with Us", href: "/get-involved/dance-with-us/" },
      { label: "Book a Performance", href: "/get-involved/book-a-performance/" },
      { label: "See A Performance", href: "/get-involved/see-a-performance/" },
      { label: "Support Our Cause", href: "/get-involved/support-our-cause/" },
    ],
  },
  {
    label: "Splendid China",
    items: [
      { label: "Splendid China 2026", href: "/splendid-china/2026/" },
      { label: "Splendid China 2025", href: "/splendid-china/2025/" },
      { label: "Splendid China 2024", href: "/splendid-china/2024/" },
      { label: "Splendid China 2023", href: "/splendid-china/2023/" },
      { label: "Splendid China 2022", href: "/splendid-china/2022/" },
      { label: "Splendid China 2019", href: "/splendid-china/2019/" },
      { label: "Splendid China 2018", href: "/splendid-china/2018/" },
      { label: "Splendid China 2017", href: "/splendid-china/2017/" },
      { label: "Splendid China 2016", href: "/splendid-china/2016/" },
      { label: "Splendid China 2015", href: "/splendid-china/2015/" },
      { label: "Splendid China 2014", href: "/splendid-china/2014/" },
      { label: "Splendid China 2013", href: "/splendid-china/2013/" },
      { label: "Splendid China 2012", href: "/splendid-china/2012/" },
      { label: "Splendid China 2011", href: "/splendid-china/2011/" },
      { label: "Splendid China 2010", href: "/splendid-china/2010/" },
      { label: "Splendid China 2009", href: "/splendid-china/2009/" },
      { label: "Splendid China 2008", href: "/splendid-china/2008/" },
    ],
  },
];

const actions = [
  { label: "Purchase Tickets", href: "/tickets/" },
  { label: "Donate", href: "/donate/" },
];

const normalizePath = (path: string) =>
  path === "/" ? "/" : `${path.replace(/\/+$/, "")}/`;
const currentPath = normalizePath(Astro.url.pathname);
const isActive = (href: string) => normalizePath(href) === currentPath;
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Madison Chinese Dance Academy home">
      <span class="brand-name">Madison Chinese Dance Academy</span>
      <span class="brand-name-short">MCDA</span>
    </a>

    <nav aria-label="Primary navigation">
      <ul class="nav-list">
        {
          navigation.map((item) =>
            item.items ? (
              <li>
                <details class:list={{ "is-active": item.items.some((child) => isActive(child.href)) }}>
                  <summary>{item.label}</summary>
                  <ul class="nav-submenu">
                    {item.items.map((child) => (
                      <li>
                        <a href={child.href} aria-current={isActive(child.href) ? "page" : undefined}>
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>

    <div class="header-actions">
      {
        actions.map((action) => (
          <a class="header-action" href={action.href} aria-current={isActive(action.href) ? "page" : undefined}>
            {action.label}
          </a>
        ))
      }
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    width: 100%;
    margin: 0;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--edge-contrast);
    background: rgb(16 26 79 / 82%);
    box-shadow: var(--header-shadow, 0 8px 28px var(--color-navy-shadow));
    backdrop-filter: blur(12px);
  }

  .header-inner {
    width: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.6rem;
    color: var(--light-text-color);
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
  }

  .brand-name-short {
    display: none;
  }

  nav {
    flex: 1;
  }

  .nav-list,
  .nav-submenu {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-list {
    justify-content: center;
    gap: 1rem;
  }

  .nav-list a,
  summary {
    display: block;
    font-weight: 600;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    color: var(--light-text-color);
    cursor: pointer;
    font-size: 0.92rem;
    text-decoration: none;
  }

  .nav-list a:hover,
  .nav-list a:focus-visible,
  summary:hover,
  summary:focus-visible,
  details.is-active > summary,
  .nav-list a[aria-current="page"] {
    color: var(--color-peach);
    background: var(--button-hover-bg);
  }

  summary {
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    display: inline-block;
    margin-left: 0.35rem;
    content: "▾";
    transition: transform var(--transition-fast);
  }

  details[open] summary::after {
    transform: rotate(180deg);
  }

  .nav-submenu {
    position: absolute;
    z-index: 20;
    display: grid;
    min-width: 13rem;
    margin-top: 0.25rem;
    padding: 0.4rem;
    border: 1px solid var(--edge-contrast);
    border-radius: 0.75rem;
    background: var(--color-deep-navy);
    box-shadow: var(--dropdown-shadow, 0 18px 42px var(--color-navy-shadow));
  }

  .nav-submenu a {
    white-space: nowrap;
  }

  .header-actions {
    display: flex;
    flex: 0 0 auto;
    gap: 1rem;
  }

  .header-action {
    font-weight: 600;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    color: var(--light-text-color);
    background: var(--color-purple);
    font-size: 1rem;
    text-decoration: none;
  }

  .header-action:hover,
  .header-action:focus-visible,
  .header-action[aria-current="page"] {
    filter: brightness(1.12);
  }

  @media (max-width: 1100px) {
    .brand-name {
      display: none;
    }

    .brand-name-short {
      display: inline;
    }

    .header-inner {
      flex-wrap: wrap;
    }

    nav {
      order: 3;
      flex-basis: 100%;
    }

    .nav-list {
      flex-wrap: wrap;
    }
  }

  @media (max-width: 620px) {
    .site-header {
      padding: 0.65rem;
    }

    .header-actions {
      margin-left: auto;
    }

    .header-action {
      padding-inline: 0.55rem;
      font-size: 0.75rem;
    }

    .nav-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .nav-list > li,
    .nav-list a,
    summary {
      width: 100%;
    }

    .nav-submenu {
      position: static;
      margin: 0.25rem 0 0;
    }
  }
</style>
